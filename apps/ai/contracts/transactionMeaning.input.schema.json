{
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "enum": ["PAYSE-ANALYSIS-1"]
    },
    "semanticTaskKind": {
      "type": "string",
      "enum": ["transactionMeaning"]
    },
    "context": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": ["PAYSE-API-0.6-4"]
        },
        "dataVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
        },
        "inputRevision": {
          "type": "integer",
          "minimum": 0
        },
        "localSessionEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "selectedAccountIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "schemaVersion",
        "dataVersion",
        "sourceVersion",
        "ruleVersion",
        "asOf",
        "inputRevision",
        "localSessionEpoch",
        "selectedAccountIds"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemKey": {
            "type": "string",
            "minLength": 1
          },
          "targetTransactionId": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "candidateKey": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "evidenceTransactionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "maxItems": 60
          }
        },
        "required": ["itemKey", "targetTransactionId", "candidateKey", "evidenceTransactionIds"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 60
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "recordKind": {
            "type": "string",
            "enum": ["account_entry", "card_purchase", "card_refund", "card_cancellation"]
          },
          "direction": {
            "type": "string",
            "enum": ["in", "out"]
          },
          "status": {
            "type": "string",
            "enum": ["posted", "approved", "cancelled", "unknown"]
          },
          "reflectionReason": {
            "type": "string",
            "enum": ["reflected", "not_reflected", "not_applicable", "unknown"]
          },
          "merchantName": {
            "type": ["string", "null"]
          },
          "description": {
            "type": ["string", "null"]
          },
          "originalTransactionId": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "transactionId",
          "recordKind",
          "direction",
          "status",
          "reflectionReason",
          "merchantName",
          "description",
          "originalTransactionId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 60
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["internal_transfer", "card_account_pair"]
          },
          "fromId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "toId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": ["kind", "fromId", "toId"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unavailableReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "reason": {
            "type": "string",
            "enum": ["outside_retention", "not_provided", "not_connected"]
          }
        },
        "required": ["transactionId", "reason"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 60
    },
    "currentClassifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "value": {
            "type": ["string", "null"],
            "enum": ["expense", "income", "internal_transfer", "card_payment", null]
          }
        },
        "required": ["transactionId", "value"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 60
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateKey": {
            "type": "string",
            "minLength": 1
          },
          "ruleVersion": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "evidenceTransactionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "maxItems": 60
          },
          "normalizedName": {
            "type": "string",
            "minLength": 1
          },
          "suggestedAmountKRW": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000000000000
          },
          "suggestedDay": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 31
          },
          "features": {
            "type": "object",
            "properties": {
              "occurrenceCount": {
                "type": "integer",
                "minimum": 0
              },
              "observedMonths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                },
                "minItems": 0,
                "maxItems": 3
              },
              "dayWithinRule": {
                "type": ["boolean", "null"]
              },
              "amountWithinRule": {
                "type": ["boolean", "null"]
              },
              "hasUnresolvedReversal": {
                "type": "boolean"
              }
            },
            "required": [
              "occurrenceCount",
              "observedMonths",
              "dayWithinRule",
              "amountWithinRule",
              "hasUnresolvedReversal"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "candidateKey",
          "ruleVersion",
          "sourceVersion",
          "evidenceTransactionIds",
          "normalizedName",
          "suggestedAmountKRW",
          "suggestedDay",
          "features"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 0
    }
  },
  "required": [
    "contractVersion",
    "semanticTaskKind",
    "context",
    "items",
    "transactions",
    "relations",
    "unavailableReferences",
    "currentClassifications",
    "candidates"
  ],
  "additionalProperties": false
}
